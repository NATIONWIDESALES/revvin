{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://olmpplfgzegzqdcznlrp.supabase.co/auth/v1",
    "resource_name": "Revvin Marketplace MCP",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "revvin-mcp",
      "version": "0.1.0",
      "title": "Revvin Marketplace"
    },
    "tools": [
      {
        "name": "search_offers",
        "title": "Search referral offers",
        "description": "Search Revvin's public marketplace of referral offers. Filter by keyword, industry/category, city, or minimum payout. Returns active, approved offers from listed businesses.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Keyword to match in offer title/description or business name.",
              "type": "string"
            },
            "category": {
              "description": "Industry/category filter (e.g. 'Home Services', 'Legal').",
              "type": "string"
            },
            "city": {
              "description": "City name to filter businesses by.",
              "type": "string"
            },
            "min_payout": {
              "description": "Minimum referral payout amount in the offer's currency.",
              "type": "number"
            },
            "limit": {
              "description": "Max results (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_offer",
        "title": "Get offer details",
        "description": "Fetch full details for a single Revvin referral offer by its ID, including business info and payout terms.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "offer_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The offer's UUID."
            }
          },
          "required": [
            "offer_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_categories",
        "title": "List offer categories",
        "description": "List the distinct industry categories currently represented in the Revvin marketplace.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
